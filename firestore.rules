rules_version = '2';

// Firestore security rules for the app.
// Not deployed automatically: review, then publish from the Firebase console
// (Firestore > Rules) or with `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Signed in with email/password, not a guest (anonymous) session
    function hasAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Profiles: people with an account can see the user list (needed to start a chat);
    // guests can only see their own. Only you can change your own profile.
    match /users/{userId} {
      allow read: if hasAccount() || isOwner(userId);
      allow write: if isOwner(userId);

      // Private data: mood check-ins, diary notes, daily routine (guests included)
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Explore/Home content library: read-only from the app (guests included), edited in the console
    match /content/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Chats need an account. Only participants can read or write a chat and its messages.
    // A chat that doesn't exist yet can be read (to check) and created by a participant.
    match /chats/{chatId} {
      allow read: if hasAccount()
        && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if hasAccount() && request.auth.uid in request.resource.data.participants;
      allow update: if hasAccount() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        function isParticipant() {
          return request.auth.uid in
            get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }
        allow read: if hasAccount() && isParticipant();
        allow create: if hasAccount() && isParticipant()
          && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
